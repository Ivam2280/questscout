# Copy to .env in the project root. Never commit real credentials.
# Neon: Connect > Node.js > enable Connection pooling > copy the URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional: use the direct (non-pooler) URL for migrations and seeding.
DIRECT_DATABASE_URL=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3001
APP_TIMEZONE=Europe/Kyiv
SEED_DEMO=true
DEMO_PAYMENTS=true
# Optional administrator. Use 8+ characters for initial creation.
# Existing accounts keep their passwords; deploys never reset them.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Google sign-in through Firebase Authentication. Web configuration is public.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Email: auto selects configured EmailJS, Resend or SMTP credentials.
MAIL_PROVIDER=auto
# Gmail/SMTP for local development. Use a Google App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# EmailJS can send through Gmail over HTTPS on Render Free without a custom domain.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Optional alternative HTTPS email provider.
RESEND_API_KEY=
EMAIL_FROM=
# Optional PayPal Sandbox. Demo checkout needs no PayPal account.
# Set DEMO_PAYMENTS=false only after configuring these sandbox credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_UAH_PER_USD=41
